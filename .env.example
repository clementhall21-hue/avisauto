# ── SUPABASE ──────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GROQ ──────────────────────────────────────────────────────
# Obtenez votre clé sur : https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STRIPE ────────────────────────────────────────────────────
# Trouvez ces valeurs dans : Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret — obtenu lors de la création du webhook dans Stripe Dashboard
# Webhook endpoint : https://votre-app.vercel.app/api/stripe/webhook
# Events : checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price ID du plan 49€/mois — créez le prix dans Stripe Dashboard → Products
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ADMIN ─────────────────────────────────────────────────────
# Mot de passe pour accéder au panel admin dans les paramètres
ADMIN_PASSWORD=votre_mot_de_passe_admin_securise

# ── RESEND (emails) ───────────────────────────────────────────
# Obtenez votre clé sur : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app
